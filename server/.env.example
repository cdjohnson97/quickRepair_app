# Utiliser le "Session pooler" (IPv4) plutôt que la connexion directe (IPv6-only sur les
# projets récents, injoignable depuis un réseau sans route IPv6 sortante).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="24h"
CORS_ORIGIN="http://localhost:5173"
PORT=3000
